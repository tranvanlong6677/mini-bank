# ==================== ENVIRONMENT VARIABLES ====================
# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env vào git!

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/minibank
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# JWT Secret (phải dài ít nhất 256 bits)
JWT_SECRET=your_super_secret_key_at_least_256_bits_long_here_123456789

# Profile
SPRING_PROFILES_ACTIVE=dev
